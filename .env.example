# Runtime environment. Use development, test, or production.
NODE_ENV=development
# HTTP port for the Atlas web process.
PORT=8080
# PostgreSQL connection URL for a host-run web process or local tooling. The
# port is mandatory. Compose constructs role-specific production URLs using
# the explicit db:5432 endpoint from the password variables below.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
# Compose-only role passwords. Use distinct 24-128 character values containing
# only letters, numbers, underscore, or hyphen; Compose places them in URLs and
# production preflight rejects reserved URL characters before remote access.
POSTGRES_BOOTSTRAP_PASSWORD=development-bootstrap-password
ATLAS_MIGRATOR_PASSWORD=development-migrator-password
ATLAS_WEB_PASSWORD=development-web-password
ATLAS_WORKER_PASSWORD=development-worker-password
# At least 32 characters. Replace before using outside local development.
SESSION_SECRET=development-session-secret-change-me-please
# Browser-visible Atlas origin. Production must use HTTPS.
ATLAS_ORIGIN=http://localhost:5173
# Filesystem directory for generated and uploaded V2 artifacts.
ARTIFACT_DIR=./artifacts
# Authentication mode. Local authentication is never permitted in production.
AUTH_MODE=local
# Explicit local-only owner credentials used by `npm run db:seed:development`.
# The seed refuses non-development environments and non-local authentication.
ATLAS_DEV_OWNER_EMAIL=
ATLAS_DEV_OWNER_NAME=
ATLAS_DEV_OWNER_PASSWORD=
# Google OAuth client ID. Required when AUTH_MODE=google in production.
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Required when AUTH_MODE=google in production.
GOOGLE_CLIENT_SECRET=
# Google OAuth callback URL. Required when AUTH_MODE=google in production.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Background worker polling interval in milliseconds.
WORKER_POLL_MS=1000

# V1 compatibility settings, retained while the V2 platform is introduced.
# V1 local administrator email.
ADMIN_EMAIL=admin@rangeway.energy
# V1 local administrator password. Replace before using outside local development.
ADMIN_PASSWORD=rangeway-dev
# Google Workspace domain accepted by the V1 sign-in flow.
GOOGLE_ALLOWED_DOMAIN=rangeway.energy
# Production owner fields are intentionally absent: pass them only to the
# explicit one-time provisioning command. Never supply a Google subject there.
# SQLite database path used by the preserved V1 application.
DATABASE_PATH=./data/rangeway-crm.sqlite
# V1 upload directory used for diligence files.
UPLOAD_DIR=./uploads
# Maximum V1 uploaded file size in megabytes.
MAX_UPLOAD_MB=30
