# Atlas production runtime configuration. Replace every REPLACE_WITH value before deployment.
# deploy.sh copies this exact file into a root-private immutable candidate stage;
# it is never incrementally synchronized into a live release tree, and the staged
# copy is removed immediately after the installed candidate .env is hash-validated.
# Database role passwords must use only letters, numbers, underscore, or hyphen.
# Use 24-128 characters because Compose places these values in PostgreSQL URLs.
# Reserved URL characters such as %, @, :, /, ?, and # are rejected before SSH.
# Compose constructs every application URL with the explicit PostgreSQL port
# db:5432; omitted or different ports are rejected before pool creation.
# ATLAS_RELEASE_SHA is not a persistent secret or operator setting. The guarded
# deploy injects the exact reviewed 40-character candidate commit at runtime.
# ATLAS_REPOSITORY_ROOT, ATLAS_INITIAL_PROVENANCE_SHA256, and the deployment
# token/lease are coordinator-only values and must never be persisted here.
NODE_ENV=production
PORT=8080
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_POSTGRES_BOOTSTRAP_PASSWORD
ATLAS_MIGRATOR_PASSWORD=REPLACE_WITH_ATLAS_MIGRATOR_PASSWORD
ATLAS_WEB_PASSWORD=REPLACE_WITH_ATLAS_WEB_PASSWORD
ATLAS_WORKER_PASSWORD=REPLACE_WITH_ATLAS_WORKER_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ATLAS_ORIGIN=https://atlas.rangeway.app
ARTIFACT_DIR=/app/artifacts
AUTH_MODE=google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://atlas.rangeway.app/api/auth/google/callback
WORKER_POLL_MS=1000
GOOGLE_ALLOWED_DOMAIN=rangeway.co
# Supply ATLAS_PRODUCTION_OWNER_EMAIL, ATLAS_PRODUCTION_OWNER_NAME, and
# ATLAS_PRODUCTION_OWNER_CONFIRM only to the explicit one-time Compose command;
# never persist them here. A Google subject is accepted only from verified OAuth.
